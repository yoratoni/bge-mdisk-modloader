{
    "git.autoRepositoryDetection": false,
    // C++ IntelliSense is served by clangd only, cpptools stays installed for its debugger
    // but its own engine is off
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=never",
        "--pch-storage=memory"
    ],
    // Warn when the resolved clangd is older than the extension expects, this project needs
    // clangd >= 20 and a stale binary fails loudly inside the MSVC STL rather than degrading
    "clangd.checkUpdates": true,
    "clangd.onConfigChanged": "restart",
    // Addresses written as "+RVA" in the research notes (e.g. "+AEAC00")
    "cSpell.ignoreRegExpList": [
        "\\+[0-9A-F]{4,}\\b"
    ],
    "cSpell.words": [
        "BBBHHBHHHHBB",
        "binarized",
        "BPAK",
        "cgro",
        "choco",
        "CUBEMAP",
        "DCMAKE",
        "Denuvo's",
        "dinput",
        "DXGI",
        "FOURCC",
        "frombuffer",
        "gast",
        "IIIIQ",
        "ilammy",
        "jdproj",
        "lfanew",
        "MDISK",
        "moddable",
        "modloader",
        "ndarray",
        "Paks",
        "partie",
        "pwsh",
        "Rayman",
        "repacker",
        "rodata",
        "safetyhook",
        "softprops",
        "SRGB",
        "steamapps",
        "tdst",
        "tobytes",
        "unbinarized",
        "UNORM",
        "Wwise",
        "Zycore",
        "Zydis"
    ]
}