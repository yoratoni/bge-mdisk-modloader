{
    "git.autoRepositoryDetection": false,
    // C++ IntelliSense is served by clangd only, cpptools stays installed for its debugger
    // but its own engine is off
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=never",
        "--pch-storage=memory"
    ],
    // Warn when the resolved clangd is older than the extension expects, this project needs
    // clangd >= 20 and a stale binary fails loudly inside the MSVC STL rather than degrading
    "clangd.checkUpdates": true,
    "clangd.onConfigChanged": "restart",
    // The Electron app ("packages/modloader") formats with Biome and lints with Nitpicker on save, from its own
    // configurations, JSON is left out so the C++ side's files keep their own formatting
    "[typescript][typescriptreact][javascript][css]": {
        "editor.codeActionsOnSave": {
            "source.action.useSortedAttributes.biome": "explicit",
            "source.action.useSortedKeys.biome": "explicit",
            "source.action.useSortedProperties.biome": "explicit",
            "source.fixAll.biome": "explicit",
            "source.fixAll.eslint": "explicit",
            "source.organizeImports.biome": "explicit"
        },
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
    },
    "eslint.workingDirectories": [
        {
            "mode": "auto"
        }
    ],
    "javascript.preferences.importModuleSpecifier": "shortest",
    "typescript.preferences.importModuleSpecifier": "non-relative",
    // Addresses written as "+RVA" in the research notes (e.g. "+AEAC00")
    "cSpell.ignoreRegExpList": [
        "\\+[0-9A-F]{4,}\\b"
    ],
    "cSpell.words": [
        "asar",
        "BBBHHBHHHHBB",
        "binarized",
        "BPAK",
        "cgro",
        "choco",
        "CUBEMAP",
        "cybearl",
        "cypack",
        "DCMAKE",
        "Denuvo's",
        "dinput",
        "DXGI",
        "FOURCC",
        "frombuffer",
        "gast",
        "IIIIQ",
        "ilammy",
        "jdproj",
        "lfanew",
        "MDISK",
        "moddable",
        "modloader",
        "ndarray",
        "nsis",
        "Paks",
        "partie",
        "pwsh",
        "Rayman",
        "repacker",
        "rodata",
        "safetyhook",
        "softprops",
        "SRGB",
        "steamapps",
        "tdst",
        "tobytes",
        "unbinarized",
        "UNORM",
        "Wwise",
        "Zycore",
        "Zydis"
    ]
}