{
    "name": "@yoratoni/mdisk-modloader",
    "version": "0.0.1",
    "description": "The desktop app of the BG&E MDISK Mod Loader, which installs mods into Beyond Good & Evil 20th Anniversary Edition.",
    "author": "yoratoni (https://github.com/yoratoni)",
    "license": "MIT",
    "private": true,
    "packageManager": "yarn@1.22.22",
    "homepage": "https://github.com/yoratoni/bge-mdisk-modloader",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yoratoni/bge-mdisk-modloader.git",
        "directory": "packages/modloader"
    },
    "bugs": {
        "url": "https://github.com/yoratoni/bge-mdisk-modloader/issues"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "main": "./dist/app/main/index.js",
    "scripts": {
        "postinstall": "node node_modules/electron/install.js",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "test": "npm run test:unit",
        "test:unit": "vitest",
        "lint": "biome check && eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "biome check --fix && biome format --write && eslint \"src/**/*.{ts,tsx}\" --fix",
        "dist": "electron-vite build && electron-builder"
    },
    "devDependencies": {
        "@alien_intelligence/eslint-plugin-nitpicker": "^0.10.1",
        "@biomejs/biome": "^2.5.2",
        "@cybearl/cypack": "^1.11.10",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@tailwindcss/vite": "^4.3.1",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^5.0.0",
        "class-variance-authority": "^0.7.1",
        "electron": "^42.5.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^5.0.0",
        "eslint": "^10.8.0",
        "lucide-react": "^1.37.0",
        "motion": "^13.1.1",
        "overlayscrollbars": "^2.16.0",
        "overlayscrollbars-react": "^0.5.6",
        "radix-ui": "^1.6.7",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.8.3",
        "vite": "^7.0.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    },
    "resolutions": {
        "@types/node": "^24.12.2"
    }
}
